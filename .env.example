# ============================================================
# CoinWise AI - 环境变量示例模板
# 复制为 .env 并根据实际环境修改
# Docker Compose 会使用 MYSQL_ROOT_PASSWORD、JWT_SECRET、
# ENCRYPTION_KEY、DATA_ENCRYPTION_KEY 这几个变量。
# ============================================================

# ════════════════════════════════════════════════════════════
# 数据库（MySQL 8.0 + aiomysql）
# ════════════════════════════════════════════════════════════
# Docker Compose MySQL root 密码（请改成强密码）
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
# 本地直接运行后端时使用；密码需与 MYSQL_ROOT_PASSWORD 保持一致
DATABASE_URL_MASTER=mysql+aiomysql://root:CHANGE_ME_MYSQL_ROOT_PASSWORD@localhost:3306/coinwise
DATABASE_URL_SLAVE=mysql+aiomysql://root:CHANGE_ME_MYSQL_ROOT_PASSWORD@localhost:3306/coinwise

# ════════════════════════════════════════════════════════════
# Redis
# ════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0

# ════════════════════════════════════════════════════════════
# JWT 认证（生产环境务必更换为随机生成的强密钥）
# ════════════════════════════════════════════════════════════
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ════════════════════════════════════════════════════════════
# Elasticsearch（可选，ES_ENABLED=false 时自动降级为 MySQL FULLTEXT）
# ════════════════════════════════════════════════════════════
ES_HOST=http://localhost:9200

# ════════════════════════════════════════════════════════════
# Celery 任务队列
# ════════════════════════════════════════════════════════════
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ════════════════════════════════════════════════════════════
# 数据加密
# ENCRYPTION_KEY 用于字段加密；DATA_ENCRYPTION_KEY 用于 AES-256-GCM
# 建议使用随机生成的 32 字节以上字符串，切勿提交真实值。
# ════════════════════════════════════════════════════════════
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_ENCRYPTION_KEY
DATA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_ENCRYPTION_KEY

# ════════════════════════════════════════════════════════════
# SMTP 邮件配置（可选，用于通知投递）
# ════════════════════════════════════════════════════════════
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ════════════════════════════════════════════════════════════
# 阿里云百炼 AI（https://dashscope.aliyun.com）
# ════════════════════════════════════════════════════════════
BAILIAN_API_KEY=
BAILIAN_MODEL=qwen-plus
BAILIAN_TEMPERATURE=0.3
BAILIAN_MAX_TOKENS=1500
BAILIAN_TOP_P=0.7
BAILIAN_ENABLE_SEARCH=false

# ════════════════════════════════════════════════════════════
# 调试模式
# ════════════════════════════════════════════════════════════
DEBUG=false
